# Local development. `npm run db:up` gives you this database.
# Use 127.0.0.1 rather than localhost: on Windows, localhost resolves to ::1
# first and Docker's published port is IPv4-only.
DATABASE_URL="postgresql://shotly:shotly@127.0.0.1:5433/shotly?schema=public"
DIRECT_URL="postgresql://shotly:shotly@127.0.0.1:5433/shotly?schema=public"

# Where guest frames and voice notes are stored.
#   local - writes to ./.storage, served back through /api/media. Fine for dev.
#   s3    - needs the four AWS values below.
STORAGE_DRIVER="local"

# AWS_REGION=""
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Absolute origin, used to build QR targets and reveal links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
